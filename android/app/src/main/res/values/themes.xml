<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Everything visible is drawn by Compose; this only sets the window. -->
    <style name="Theme.Caelum" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/obsidian</item>
    </style>

    <style name="Theme.Caelum.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/obsidian</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Caelum</item>
    </style>
</resources>
